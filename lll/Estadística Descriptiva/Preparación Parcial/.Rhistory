# Inicializamos el df de edad
edad <- pediatria$edad_anos
# a) Tendencia Central
# - Media:
mean(edad, na.rm = TRUE)
# - Mediana:
median(edad, na.rm = TRUE)
# - Moda:
# R por defecto no trae la función de moda pero se puede crear de la siguiente manera
moda <- function(v) {
uv <- unique(v[!is.na(v)])
uv[which.max(tabulate(match(v, uv)))]
}
moda(edad)
moda(edad)
# - Moda:
# R por defecto no trae la función de moda pero se puede crear de la siguiente manera
moda <- function(v) {
uv <- unique(v[!is.na(v)])
uv[which.max(tabulate(match(v, uv)))]
}
moda(edad)
# - Moda:
# R por defecto no trae la función de moda pero se puede crear de la siguiente manera
moda <- function(x) {
ux <- unique(x)
ux[which.max(tabulate(match(x, ux)))]
}
moda(edad)
View(moda)
View(pediatria)
