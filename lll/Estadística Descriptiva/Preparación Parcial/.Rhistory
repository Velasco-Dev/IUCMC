# Paleta de colores para las gráficas
scale_fill_brewer(palette = "Set2")
sexo_plot <- ggplot(data = pediatria, aes(x = sexo, fill = sexo)) +
geom_bar() +
labs(title = "Distribución de pacientes por sexo",
